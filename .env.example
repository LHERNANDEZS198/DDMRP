# --- PostgreSQL analitico (contenedor "db") ---
POSTGRES_DB=ddmrp
POSTGRES_USER=ddmrp
POSTGRES_PASSWORD=@
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Siesa (MSSQL, solo lectura) ---
SIESA_HOST=siesabd
SIESA_PORT=1433
SIESA_DB=funat
SIESA_DB_S=Stores
SIESA_CIA=1
# Bodega del CEDI: de aqui sale el inventario finito que se reparte entre las tiendas
SIESA_CEDI_BODEGA=PT001
# Costo promedio unitario POR INSTALACION (reporte 'Existencia a la fecha por bodega': "Costo prom. unit. (ins)"): tabla y columna de Siesa,
# unidas por item e instalacion de la bodega (p.ej. F01). Reglas de pedido > Revisar un inventario ayuda a ubicarlas si no son estas.
SIESA_COSTO_TABLA=t132_mc_items_instalacion
SIESA_COSTO_COLUMNA=f132_costo_prom_uni
# Puerto donde se abre la UI (http://localhost:PUERTO)
FRONTEND_PORT=8095
# Donde escucha la UI: 127.0.0.1 = solo este servidor (se entra por el nginx con HTTPS). 0.0.0.0 abre HTTP plano a la red (solo pruebas)
FRONTEND_BIND=127.0.0.1
# Solo se importan los items con alguno de estos criterios (plan:criterio), con todos sus otros criterios. 001 CATEGORIA: 0001 Funat, 0002 terceros. Vacio = todos
SIESA_CRITERIOS_ITEMS=001:0001,001:0002,001:0003
SIESA_USER=
SIESA_PASSWORD=

# --- MySQL de autenticacion (reloj) ---
AUTH_MYSQL_HOST=relojfunat
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_DB=BDRELOJ
AUTH_MYSQL_USER=
AUTH_MYSQL_PASSWORD=
# Primer arranque: CODIGOs de reloj (coma) que entran como admin de esta app y luego asignan perfiles
ADMIN_BOOTSTRAP=
# Sesion abierta: cada cuantos minutos se le pregunta a reloj si el usuario sigue activo (0 = nunca). Si reloj no responde no se saca a nadie.
AUTH_REVALIDAR_MINUTOS=15
# Consulta que devuelve una fila si el usuario SIGUE activo en reloj (por defecto: USUARIOS.activo = 1; la columna nula cuenta como activo). Se puede cambiar:
# AUTH_ACTIVO_QUERY=SELECT 1 FROM USUARIOS WHERE CODIGO = :usuario AND COALESCE(activo, 1) = 1
# Freno a la fuerza bruta del login: tras N claves malas de un usuario en la ventana (min), ese usuario espera X min
LOGIN_MAX_FALLOS=5
LOGIN_VENTANA_MIN=15
LOGIN_BLOQUEO_MIN=15
# /docs del backend (solo desarrollo)
HABILITAR_DOCS=false

# --- App ---
JWT_SECRET=@
JWT_EXPIRE_MINUTES=480   # JWT_SECRET: largo y aleatorio (openssl rand -hex 32); la app no debe correr con uno corto
CORE_BIN=/usr/local/bin/ddmrp_core
ETL_CRON_HOUR=2

# --- Envio de ordenes de compra a Siesa (web service WSUNOEE, mismo que usa ChaTest para crear terceros) ---
# Sin SIESA_WS_URL el envio queda deshabilitado (la vista previa del plano sigue funcionando).
SIESA_WS_URL=
SIESA_WS_USER=
SIESA_WS_PASSWORD=
SIESA_WS_CONEXION=
SIESA_WS_CIA=1
# Stores (empresa 21): sin SIESA_WS_CONEXION_S no puede enviar. URL / usuario / clave / cia vacios = los mismos de arriba.
SIESA_WS_URL_S=
SIESA_WS_USER_S=
SIESA_WS_PASSWORD_S=
SIESA_WS_CONEXION_S=
SIESA_WS_CIA_S=

# --- Destino de las OC ---
# directo = DDMRP las crea en Siesa (prueba) | bpm = DDMRP arma el plano y lo entrega al BPM (aprueba, crea en Siesa, PDF, correo)
OC_DESTINO=directo
BPM_URL=
BPM_SECRET=
# total (pesos) desde el cual la OC pasa por revision humana en el BPM; 0 = toda OC se revisa
OC_UMBRAL_REVISION=0
# Monedas del documento de OC (ver docs/sql/oc_monedas.sql). Si Siesa dice «La moneda de conversion del documento no es la definida en la compania», ajustar OC_MONEDA_CONV
OC_MONEDA=COP
OC_MONEDA_CONV=USD
OC_MONEDA_LOCAL=COP
OC_IND_TASA=0
OC_TASA_CONV=0
OC_TASA_LOCAL=0
