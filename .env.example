# --- PostgreSQL analitico (contenedor "db") ---
POSTGRES_DB=ddmrp
POSTGRES_USER=ddmrp
POSTGRES_PASSWORD=@
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Siesa (MSSQL, solo lectura) ---
SIESA_HOST=siesabd
SIESA_PORT=1433
SIESA_DB=funat
SIESA_DB_S=Stores
SIESA_CIA=1
# Bodega del CEDI: de aqui sale el inventario finito que se reparte entre las tiendas
SIESA_CEDI_BODEGA=PT001
# Columna de t400_cm_existencia con el costo promedio unitario (reporte 'Existencia a la fecha por bodega': "Costo prom. unit. (ins)").
# Si el nombre no es este, Reglas de pedido > Revisar un inventario muestra las columnas reales de Siesa.
SIESA_COSTO_COLUMNA=f400_costo_prom_uni
# Puerto donde se abre la UI (http://localhost:PUERTO)
FRONTEND_PORT=8095
# Solo se importan los items con alguno de estos criterios (plan:criterio), con todos sus otros criterios. 001 CATEGORIA: 0001 Funat, 0002 terceros. Vacio = todos
SIESA_CRITERIOS_ITEMS=001:0001,001:0002
SIESA_USER=
SIESA_PASSWORD=

# --- MySQL de autenticacion (reloj) ---
AUTH_MYSQL_HOST=relojfunat
AUTH_MYSQL_PORT=3306
AUTH_MYSQL_DB=BDRELOJ
AUTH_MYSQL_USER=
AUTH_MYSQL_PASSWORD=
# Primer arranque: CODIGOs de reloj (coma) que entran como admin de esta app y luego asignan perfiles
ADMIN_BOOTSTRAP=

# --- App ---
JWT_SECRET=@
JWT_EXPIRE_MINUTES=480
CORE_BIN=/usr/local/bin/ddmrp_core
ETL_CRON_HOUR=2
